// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  password     String
  name         String
  role         String   @default("admin")
  avatar       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  approvedUpdates TrackingUpdate[]
  activityLogs    ActivityLog[]

  @@map("admins")
}

model Shipment {
  id               String   @id @default(cuid())
  trackingNumber   String   @unique
  status           String   @default("created")
  
  // Sender info
  senderName       String
  senderEmail      String?
  senderPhone      String?
  senderAddress    String
  senderCity       String
  senderCountry    String
  
  // Receiver info
  receiverName     String
  receiverEmail    String?
  receiverPhone    String?
  receiverAddress  String
  receiverCity     String
  receiverCountry  String
  
  // Shipment details
  shipmentType     String   @default("package")
  weight           Float
  weightUnit       String   @default("kg")
  dimensions       String?
  description      String?
  
  // Route
  originCity       String
  originCountry    String
  originLat        Float?
  originLng        Float?
  destinationCity  String
  destinationCountry String
  destinationLat   Float?
  destinationLng   Float?
  
  // Current location
  currentCity      String?
  currentCountry   String?
  currentLat       Float?
  currentLng       Float?
  
  // Dates
  estimatedDelivery DateTime?
  actualDelivery    DateTime?
  shippedAt        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  // Financial
  declaredValue    Float?
  currency         String?  @default("USD")
  
  // Service
  serviceType      String?  @default("standard")
  priority         String?  @default("normal")
  transportMode    String?  @default("land")
  containsPets     Boolean  @default(false)
  
  trackingUpdates  TrackingUpdate[]
  pendingUpdates   PendingUpdate[]

  @@map("shipments")
}

model TrackingUpdate {
  id          String   @id @default(cuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  
  location    String
  city        String?
  country     String?
  lat         Float?
  lng         Float?
  status      String
  description String
  photo       String?
  timestamp   DateTime @default(now())
  
  approvedBy  String?
  approvedAt  DateTime?
  admin       Admin?   @relation(fields: [approvedBy], references: [id])
  
  createdAt   DateTime @default(now())

  @@map("tracking_updates")
}

model PendingUpdate {
  id          String   @id @default(cuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  
  location    String
  city        String?
  country     String?
  lat         Float?
  lng         Float?
  status      String
  description String
  photo       String?
  timestamp   DateTime @default(now())
  
  submittedBy String?
  notes       String?
  
  reviewStatus String   @default("pending")
  reviewedBy   String?
  reviewedAt   DateTime?
  reviewNotes  String?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("pending_updates")
}

model ActivityLog {
  id          String   @id @default(cuid())
  adminId     String?
  admin       Admin?   @relation(fields: [adminId], references: [id])
  action      String
  entity      String?
  entityId    String?
  details     String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@map("activity_logs")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
