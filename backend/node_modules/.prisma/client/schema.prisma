generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id              String           @id @default(cuid())
  email           String           @unique
  password        String
  name            String
  role            String           @default("admin")
  avatar          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  activityLogs    ActivityLog[]
  approvedUpdates TrackingUpdate[]

  @@map("admins")
}

model Shipment {
  id                 String           @id @default(cuid())
  trackingNumber     String           @unique
  status             String           @default("created")
  senderName         String
  senderEmail        String?
  senderPhone        String?
  senderAddress      String
  senderCity         String
  senderCountry      String
  receiverName       String
  receiverEmail      String?
  receiverPhone      String?
  receiverAddress    String
  receiverCity       String
  receiverCountry    String
  shipmentType       String           @default("package")
  weight             Float
  weightUnit         String           @default("kg")
  dimensions         String?
  description        String?
  originCity         String
  originCountry      String
  originLat          Float?
  originLng          Float?
  destinationCity    String
  destinationCountry String
  destinationLat     Float?
  destinationLng     Float?
  currentCity        String?
  currentCountry     String?
  currentLat         Float?
  currentLng         Float?
  estimatedDelivery  DateTime?
  actualDelivery     DateTime?
  shippedAt          DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  declaredValue      Float?
  currency           String?          @default("USD")
  serviceType        String?          @default("standard")
  priority           String?          @default("normal")
  transportMode      String?          @default("land")
  containsPets       Boolean          @default(false)
  pendingUpdates     PendingUpdate[]
  trackingUpdates    TrackingUpdate[]

  @@map("shipments")
}

model TrackingUpdate {
  id          String    @id @default(cuid())
  shipmentId  String
  location    String
  city        String?
  country     String?
  lat         Float?
  lng         Float?
  status      String
  description String
  photo       String?
  timestamp   DateTime  @default(now())
  approvedBy  String?
  approvedAt  DateTime?
  createdAt   DateTime  @default(now())
  admin       Admin?    @relation(fields: [approvedBy], references: [id])
  shipment    Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@map("tracking_updates")
}

model PendingUpdate {
  id           String    @id @default(cuid())
  shipmentId   String
  location     String
  city         String?
  country      String?
  lat          Float?
  lng          Float?
  status       String
  description  String
  photo        String?
  timestamp    DateTime  @default(now())
  submittedBy  String?
  notes        String?
  reviewStatus String    @default("pending")
  reviewedBy   String?
  reviewedAt   DateTime?
  reviewNotes  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  shipment     Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@map("pending_updates")
}

model ActivityLog {
  id        String   @id @default(cuid())
  adminId   String?
  action    String
  entity    String?
  entityId  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())
  admin     Admin?   @relation(fields: [adminId], references: [id])

  @@map("activity_logs")
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
